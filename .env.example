# Corpus Environment Configuration

# ---------------------------------------------------------
# Search Configuration
# ---------------------------------------------------------
# Choose between 'lexical' (default keyword search) or 'semantic' (local embeddings via Transformers.js)
DOC_SEARCH_METHOD=semantic

# ---------------------------------------------------------
# Version Control System Configuration
# ---------------------------------------------------------
VCS_PROVIDER=github

# Your GitHub Organization or Username
GIT_ORG=your-github-org-or-username

# Your GitHub Personal Access Token (Classic or Fine-Grained)
GIT_PAT=your-github-personal-access-token

# ---------------------------------------------------------
# Optional Features
# ---------------------------------------------------------
# Enable AI agents to file issues for missing documentation
# ENABLE_GAP_REPORTING=true
# GITHUB_PROJECT=your-github-org/doc-gaps-repo
